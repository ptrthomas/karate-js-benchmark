# Minimal env for etc/ec2-benchmark.sh — copy somewhere private, fill in, `source` it.
#
# These two are ALL you need in a typical account: the script then uses your default
# VPC's subnet and creates (and afterwards deletes) an ephemeral ssh key pair for the
# run. The IAM principal needs ec2 run/terminate/describe, security-group and key-pair
# create/delete, and ssm:GetParameters (for the AMI lookup).
export AWS_PROFILE=your-profile
export AWS_REGION=us-east-2

# Optional overrides — only needed when the defaults don't fit:
# export BENCH_SUBNET=subnet-xxxxxxxx       # a public subnet (no default VPC, or a custom one)
# export BENCH_KEY_NAME=your-key            # an existing EC2 key pair...
# export BENCH_KEY_FILE=/path/to/key.pem    # ...and its private key (0600)
# export BENCH_INSTANCE_TYPE=c6a.2xlarge    # keep >=8 vCPU — see the script header for why
# export BENCH_RUNS=3
# export KARATE_SRC=/path/to/karate         # if your checkout is not at ../karate

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.karatelabs</groupId>
    <artifactId>karate-js-benchmark</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Karate JS Benchmark</name>
    <description>Performance benchmark comparing Karate's JavaScript engine against Rhino and GraalJS</description>
    <url>https://github.com/ptrthomas/karate-js-benchmark</url>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- karate-js is NOT taken from Maven Central - it is built from a local checkout of
             karatelabs/karate (main) by build.sh, which installs it into ~/.m2 at this version.
             Keep this in sync with the <version> in that repo's root pom.xml. -->
        <karate.version>2.1.2.RC2</karate.version>
        <rhino.version>1.9.1</rhino.version>
        <graaljs.version>25.2.4</graaljs.version>
        <!-- benchmark CSV output path, overridable with -Dexec.args; the markdown block is
             written alongside it with a .md extension -->
        <exec.args>target/benchmark.csv</exec.args>
    </properties>

    <dependencies>
        <!-- Karate JS Engine -->
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-js</artifactId>
            <version>${karate.version}</version>
        </dependency>

        <!-- Mozilla Rhino -->
        <dependency>
            <groupId>org.mozilla</groupId>
            <artifactId>rhino</artifactId>
            <version>${rhino.version}</version>
        </dependency>

        <!-- GraalJS -->
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>js-community</artifactId>
            <version>${graaljs.version}</version>
            <type>pom</type>
        </dependency>

        <!-- SLF4J to suppress logging warnings -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>2.0.9</version>
        </dependency>
    </dependencies>

    <build>
        <!-- the engine versions are reported at runtime from this filtered file, never a hardcoded
             constant - so a version bump is a one-line edit in <properties> above -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>io.karatelabs.benchmark.JsEngineBenchmark</mainClass>
                    <arguments>
                        <argument>${exec.args}</argument>
                    </arguments>
                    <systemProperties>
                        <systemProperty>
                            <key>polyglot.engine.WarnInterpreterOnly</key>
                            <value>false</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
